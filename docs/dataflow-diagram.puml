@startuml
' ============================================================
'  Money Transfer System — High-Level End-to-End Data Flow
'  Branch: g_c  |  Paste into https://www.planttext.com
'  (native PlantUML, no external includes required)
' ============================================================
title Money Transfer System — High-Level End-to-End Data Flow (branch g_c)

left to right direction
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam actorStyle awesome
skinparam rectangle {
  BackgroundColor #EAF2FF
  BorderColor #3B6DB3
  RoundCorner 12
}
skinparam database {
  BackgroundColor #FFF6E0
  BorderColor #C08A2A
}

' ---- External entities ----
actor "User"  as user
actor "Admin" as admin
rectangle "Gmail SMTP\n(external)" as smtp #FBEAEA

' ---- Processes ----
rectangle "1.0\n**Auth & OTP**\nsignup · login 2FA\nreset · refresh · verify-pwd" as P1
rectangle "2.0\n**Account, Balance & Bank-link**\ndetails · encrypted balance\nPDF statement" as P2
rectangle "3.0\n**Money Transfer**\nvalidate · debit/credit\nidempotency" as P3
rectangle "4.0\n**Rewards**\nearn points · redeem cashback" as P4
rectangle "5.0\n**Admin Management**\nusers & accounts\nactivate / deactivate" as P5

' ---- Data stores ----
database "users"            as D1
database "accounts"         as D2
database "transaction_logs" as D3
database "bank_details"     as D4
database "otp_tokens"       as D5
database "reward_ledger"    as D6

' ---- 1.0 Auth & OTP ----
user --> P1 : credentials / OTP
P1 --> smtp : OTP email (async)
P1 --> user : JWT access + refresh
P1 <--> D5 : OTP issue / verify
P1 <--> D1 : user record

' ---- 2.0 Account, Balance & Bank-link ----
user --> P2 : view balance / statement / link bank
P2 --> user : **encrypted balance** / PDF
P2 <--> D2 : account
P2 --> D3 : read history
P2 <--> D4 : bank record
P2 <--> D1 : link account id

' ---- 3.0 Money Transfer ----
user --> P3 : transfer request (JWT)
P3 <--> D2 : debit / credit + sync
P3 --> D3 : SUCCESS / FAILED log
P3 --> P4 : award points

' ---- 4.0 Rewards ----
user --> P4 : view / redeem points
P4 <--> D1 : points balance
P4 <--> D6 : reward ledger
P4 --> D2 : cashback credit
P4 --> D3 : cashback txn

' ---- 5.0 Admin ----
admin --> P5 : manage (JWT, ROLE_ADMIN)
P5 <--> D1 : user status
P5 <--> D2 : account status

legend right
  | Tier | Detail |
  | Auth | 2FA: password (step 1) + email OTP (step 2, password-less) |
  | Tokens | JWT access (10 min) + refresh (7 days), auto-refresh on 401 |
  | Balance | AES-encrypted to the user; admin views stay plaintext |
  | Transfer | failed attempt logged in a separate REQUIRES_NEW tx |
  | Rewards | 1 pt / ₹100 (weekend 2x); redeem ≥500 pts from CASHBACK acct |
endlegend
@enduml
